  },
  "prompt": {
    "temperature": 0,
    "max_output_tokens": 256,
    "max_input_tokens_for_budget": 1024,
    "repeats": 1
  },
  "splits": {
    "development": 48,
    "tuning": 12,
    "held_out": 12,
    "threshold_fitting": [
      "dev",
      "tuning"
    ],
    "final_evaluation": [
      "held_out"
    ]
  },
  "core_models": [
    {
      "provider": "meta",
      "model": "muse-wonder-1.0"
    },
    {
      "provider": "meta",
      "model": "muse-spark-1.3"
    },
    {
      "provider": "meta",
      "model": "muse-spark-1.2"
    }
  ],
  "conditional_models": [],
  "provider_diagnosis": {
    "models": [
      "muse-spark-1.3",
      "muse-spark-1.2",
      "muse-spark-1.1",
      "muse-wonder-1.0"
    ],
    "input_token_cap": 256,
    "output_token_cap": 64,
    "prompt": "Return only OK."
  },
  "statistics": {
    "confidence_level": 0.95,
    "bootstrap_resamples": 2000,
    "seed": 0,
    "severe_failure_threshold": 0.2,
    "failure_threshold": 0.5,
    "covariance_shrinkage_intensity": 0.25,
    "prior_strength": 4.0,
    "maximum_prior_strength": 5.0,
