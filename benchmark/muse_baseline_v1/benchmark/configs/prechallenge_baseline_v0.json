    "ground_truth_routing": false,
    "reconciliation": "RECONCILIATION_V1",
    "execution": "offline replay from paired single-model observations; no additional provider calls"
  },
  "sequential_racing": {
    "max_additional_calls": 48,
    "eligible_questions": [
      "GPT/Qwen complementarity uncertainty",
      "overlapping S2/S3/S4 frontier",
      "verification rescue probability",
      "unstable tail estimates"
    ],
    "stop_dominated_policies": true
