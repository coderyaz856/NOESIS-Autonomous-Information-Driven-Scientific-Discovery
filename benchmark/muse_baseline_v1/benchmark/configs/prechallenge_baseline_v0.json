{
  "version": "pre-challenge-baseline-v0-protocol (Muse-only rerun v1)",
  "status": "PLANNED_AWAITING_APPROVAL",
  "scoring": {
    "primary": "SCORING_V1",
    "secondary_reproducibility_metric": "primary_v0",
