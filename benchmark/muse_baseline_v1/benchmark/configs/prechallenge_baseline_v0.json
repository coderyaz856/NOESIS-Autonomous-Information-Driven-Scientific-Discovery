    "definitions": [
      {
        "id": "S0",
        "description": "GPT-OSS only"
      },
      {
        "id": "S1",
        "description": "Qwen only"
      },
      {
        "id": "S2",
        "description": "Always Qwen + GPT-OSS"
      },
      {
        "id": "S3",
        "description": "Qwen first, selectively escalate to GPT-OSS"
      },
      {
        "id": "S4",
        "description": "GPT-OSS first, selectively escalate to Qwen"
      }
    ],
    "runtime_signals_only": [
      "task_family",
      "schema_or_constraint_failure",
      "task_risk_level",
      "historical_task_family_error_ucb",
      "explicit_abstention"
